.doc-header {
    position: sticky;
    top: 18px;
    z-index: 20;
    display: grid;
    gap: 16px;
    padding: 18px 20px;
    margin-bottom: 18px;
    border-radius: 28px;
}

.doc-header__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.doc-title {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
}

.doc-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
}

.doc-layout.is-toc-collapsed {
    grid-template-columns: 80px minmax(0, 1fr);
}

.doc-toc-sidebar {
    position: sticky;
    top: 18px;
    display: grid;
    gap: 16px;
    padding: 18px;
    border-radius: 28px;
}

.doc-toc-sidebar__head {
    display: grid;
    gap: 10px;
}

.doc-toc-toggle {
    justify-content: space-between;
    width: 100%;
}

.doc-layout.is-toc-collapsed .doc-toc-toggle {
    padding-inline: 0;
    justify-content: center;
}

.doc-layout.is-toc-collapsed #tocToggleLabel,
.doc-layout.is-toc-collapsed #docTocTitle,
.doc-layout.is-toc-collapsed #docTocBody {
    display: none;
}

.doc-layout.is-toc-collapsed .doc-toc-sidebar {
    justify-items: center;
}

.doc-toc-body:empty {
    display: none;
}

.doc-main-column {
    display: grid;
    gap: 18px;
}

.doc-content-panel {
    padding: 22px 24px 30px;
    border-radius: 32px;
}

.toc-panel {
    margin: 0;
    padding: 0;
    border-radius: 0;
    background: none;
    border: 0;
}

.toc-panel h2 {
    margin: 0 0 12px;
    font-size: 1rem;
}

.toc-list {
    display: grid;
    gap: 8px;
}

.toc-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 14px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.62);
}

.toc-link:hover {
    color: var(--brand);
    transform: translateX(4px);
}

.toc-link[data-depth="2"] {
    margin-left: 12px;
}

.toc-link[data-depth="3"] {
    margin-left: 24px;
}

.markdown-body {
    font-size: 1rem;
    color: var(--text-primary);
}

.markdown-body > *:first-child {
    margin-top: 0;
}

.markdown-body h1,
.markdown-body h2,
.markdown-body h3,
.markdown-body h4 {
    margin: 2rem 0 0.9rem;
    line-height: 1.18;
    letter-spacing: -0.03em;
}

.markdown-body h1 {
    font-size: 2rem;
}

.markdown-body h2 {
    font-size: 1.55rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.markdown-body h3 {
    font-size: 1.22rem;
}

.markdown-body p,
.markdown-body ul,
.markdown-body ol,
.markdown-body table,
.markdown-body blockquote,
.markdown-body pre {
    margin: 0 0 1rem;
}

.markdown-body ul,
.markdown-body ol {
    padding-left: 1.4rem;
}

.markdown-body li + li {
    margin-top: 0.45rem;
}

.markdown-body a {
    color: var(--brand-cool);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
}

.markdown-body code {
    padding: 0.16rem 0.42rem;
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.06);
    font-family: "Cascadia Code", Consolas, monospace;
    font-size: 0.92em;
}

.markdown-body pre {
    padding: 1rem 1.1rem;
    border-radius: 18px;
    background: #0f172a;
    color: #e2e8f0;
    overflow-x: auto;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
}

.markdown-body pre code {
    padding: 0;
    background: transparent;
}

.markdown-body blockquote {
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--brand-cool);
    border-radius: 0 18px 18px 0;
    background: rgba(14, 165, 233, 0.08);
    color: var(--text-secondary);
}

.markdown-body table {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: inset 0 0 0 1px rgba(148, 163, 184, 0.18);
}

.markdown-body th,
.markdown-body td {
    padding: 0.85rem 0.95rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
    text-align: left;
}

.markdown-body th {
    background: rgba(15, 23, 42, 0.05);
    font-weight: 700;
}

.doc-error {
    display: grid;
    place-items: center;
    gap: 14px;
    min-height: 260px;
    text-align: center;
}

@media (max-width: 720px) {
    .doc-header {
        top: 10px;
    }

    .doc-layout,
    .doc-layout.is-toc-collapsed {
        grid-template-columns: 1fr;
    }

    .doc-toc-sidebar {
        position: static;
    }

    .doc-layout.is-toc-collapsed #tocToggleLabel,
    .doc-layout.is-toc-collapsed #docTocTitle,
    .doc-layout.is-toc-collapsed #docTocBody {
        display: initial;
    }

    .doc-content-panel {
        padding: 18px 18px 24px;
    }
}
