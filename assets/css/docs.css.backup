.docs-layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
}

.docs-sidebar {
    position: sticky;
    top: 20px;
    padding: 20px;
    border-radius: 28px;
}

.docs-sidebar__header {
    display: grid;
    gap: 12px;
    margin-bottom: 22px;
}

.tab-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.tab-button {
    padding: 0 14px;
    min-height: 40px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
}

.tab-button.is-active {
    color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--brand-cool));
    box-shadow: 0 14px 26px rgba(2, 132, 199, 0.18);
}

.sidebar-stack {
    display: grid;
    gap: 10px;
}

.sidebar-item {
    padding: 0;
    border-radius: 18px;
    overflow: hidden;
}

.sidebar-item__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-weight: 700;
    width: 100%;
    padding: 14px 16px;
    text-align: left;
}

.sidebar-item__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.12);
    color: var(--brand-cool);
    font-size: 0.85rem;
}

.sidebar-item.is-active {
    border-color: rgba(15, 118, 110, 0.24);
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(15, 118, 110, 0.12));
}

.sidebar-sublist {
    display: grid;
    gap: 8px;
    margin: 0 14px 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
}

.sidebar-subitem {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    border-radius: 14px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid transparent;
}

.sidebar-subitem:hover,
.sidebar-subitem.is-active {
    transform: translateX(4px);
    border-color: rgba(14, 165, 233, 0.18);
    color: var(--brand-cool);
}

.docs-main {
    display: grid;
    gap: 20px;
}

.toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    border-radius: 24px;
}

.toolbar__summary {
    display: grid;
    gap: 4px;
}

.toolbar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.document-stack {
    display: grid;
    gap: 14px;
}

.doc-item {
    display: grid;
    gap: 12px;
    padding: 18px 20px;
    overflow: hidden;
}

.doc-item__title {
    margin: 0;
    font-size: 1.04rem;
    font-weight: 700;
}

.doc-item__summary {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
}

.doc-item__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.doc-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
}

.status-badge--neutral {
    background: rgba(148, 163, 184, 0.12);
    color: var(--text-secondary);
}

.status-badge--success {
    background: rgba(4, 120, 87, 0.12);
    color: var(--success);
}

.status-badge--warning {
    background: rgba(217, 119, 6, 0.12);
    color: var(--warning);
}

.status-badge--danger {
    background: rgba(220, 38, 38, 0.12);
    color: var(--danger);
}

@media (max-width: 980px) {
    .docs-layout {
        grid-template-columns: 1fr;
    }

    .docs-sidebar {
        position: static;
    }
}
